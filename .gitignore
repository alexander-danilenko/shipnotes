# Local environment file (never commit secrets).
.env

# Session scratch buffer (machine-local; docs/ is tracked).
.remember/

# Machine-local Compound Engineering settings (the shared config.yaml is tracked).
.compound-engineering/*.local.yaml

# GoReleaser build output (local `goreleaser build/release` runs).
dist/

# Built binary (produced by `go build -o shipnotes .`).
/shipnotes

# Editor / OS noise.
.idea/
.vscode/
.DS_Store

# Compound Engineering plans and brainstorms: scratch for in-flight features; outcomes go through /ce-compound.
docs/plans/
docs/brainstorms/
