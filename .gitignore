# Local environment file (never commit secrets).
.env

# Session scratch buffer (machine-local; docs/ is tracked).
.remember/

# Machine-local Compound Engineering settings (the .example.yaml is tracked).
.compound-engineering/*.local.yaml

# GoReleaser build output (local `goreleaser build/release` runs).
dist/

# Built binary (produced by `go build -o shipnotes .`).
/shipnotes

# Editor / OS noise.
.idea/
.vscode/
.DS_Store
